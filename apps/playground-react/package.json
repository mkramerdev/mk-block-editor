{
  "name": "playground-react",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:prepare": "node ../../scripts/assert-runtime-resolution.mjs playground-react",
    "dev:consumer": "vite --port 3001 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3001",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/editor-first-draft": "workspace:*",
    "@repo/editor-web": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^6.0.5",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vite": "^8.2.1"
  }
}
