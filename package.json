{
  "name": "mk-block-editor",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:reset:first-draft": "pnpm --filter @repo/editor-first-draft reset:postgres",
    "db:seed:first-draft": "pnpm --filter @repo/editor-first-draft seed:postgres",
    "lint": "pnpm run format:check && turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  }
}
