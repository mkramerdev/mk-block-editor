{
  "name": "@repo/editor-react",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic React hooks and utilities for editors — shared by editor-web (React DOM) and editor-mobile (React Native). No DOM dependency.",
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./store": {
      "types": "./dist/api/store.d.ts",
      "import": "./dist/api/store.js"
    },
    "./selection": {
      "types": "./dist/api/selection.d.ts",
      "import": "./dist/api/selection.js"
    },
    "./selection-model": {
      "types": "./dist/selection/model/types.d.ts",
      "import": "./dist/selection/model/types.js"
    },
    "./editor": {
      "types": "./dist/api/editor.d.ts",
      "import": "./dist/api/editor.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev:compiler": "tsc -p tsconfig.build.json --watch",
    "check-types:source": "tsc --noEmit -p tsconfig.json",
    "check-types:tests": "tsc --noEmit -p tsconfig.test.json",
    "check-types": "pnpm run check-types:source && pnpm run check-types:tests",
    "typecheck": "pnpm run check-types",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/editor-core": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.0.15",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.18",
    "eslint": "^9.39.1",
    "react": "^19.2.0",
    "typescript": "5.9.2",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
