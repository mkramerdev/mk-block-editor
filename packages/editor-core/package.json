{
  "name": "@repo/editor-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic editor core domains for explicit editor compositions. No DOM dependency. Shared by web and mobile.",
  "exports": {
    "./kernel": {
      "types": "./dist/api/kernel.d.ts",
      "import": "./dist/api/kernel.js"
    },
    "./document": {
      "types": "./dist/api/document.d.ts",
      "import": "./dist/api/document.js"
    },
    "./definitions": {
      "types": "./dist/api/definitions.d.ts",
      "import": "./dist/api/definitions.js"
    },
    "./selection": {
      "types": "./dist/api/selection.d.ts",
      "import": "./dist/api/selection.js"
    },
    "./operations": {
      "types": "./dist/api/operations.d.ts",
      "import": "./dist/api/operations.js"
    },
    "./editing": {
      "types": "./dist/api/editing.d.ts",
      "import": "./dist/api/editing.js"
    },
    "./content": {
      "types": "./dist/api/content.d.ts",
      "import": "./dist/api/content.js"
    },
    "./content/rich-text": {
      "types": "./dist/api/content/rich-text.d.ts",
      "import": "./dist/api/content/rich-text.js"
    },
    "./content/marks": {
      "types": "./dist/api/content/marks.d.ts",
      "import": "./dist/api/content/marks.js"
    },
    "./content/inline-atoms": {
      "types": "./dist/api/content/inline-atoms.d.ts",
      "import": "./dist/api/content/inline-atoms.js"
    },
    "./content/urls": {
      "types": "./dist/api/content/urls.d.ts",
      "import": "./dist/api/content/urls.js"
    },
    "./metadata": {
      "types": "./dist/api/metadata.d.ts",
      "import": "./dist/api/metadata.js"
    },
    "./codecs": {
      "types": "./dist/api/codecs.d.ts",
      "import": "./dist/api/codecs.js"
    },
    "./testing": {
      "types": "./dist/api/testing.d.ts",
      "import": "./dist/api/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev:compiler": "tsc -p tsconfig.build.json --watch",
    "check-types:source": "tsc --noEmit -p tsconfig.json",
    "check-types:tests": "tsc --noEmit -p tsconfig.test.json",
    "check-types": "pnpm run check-types:source && pnpm run check-types:tests",
    "typecheck": "pnpm run check-types",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.0.15",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vitest": "^4.0.8"
  }
}
