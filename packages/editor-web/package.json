{
  "name": "@repo/editor-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Generic React DOM editor surface",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./block-renderer": {
      "types": "./dist/api/block-renderer.d.ts",
      "import": "./dist/api/block-renderer.js"
    },
    "./document-runtime": {
      "types": "./dist/api/document-runtime.d.ts",
      "import": "./dist/api/document-runtime.js"
    },
    "./editor-definition": {
      "types": "./dist/api/editor-definition.d.ts",
      "import": "./dist/api/editor-definition.js"
    },
    "./editor": {
      "types": "./dist/api/editor.d.ts",
      "import": "./dist/api/editor.js"
    },
    "./clipboard-runtime": {
      "types": "./dist/api/clipboard-runtime.d.ts",
      "import": "./dist/api/clipboard-runtime.js"
    },
    "./editable-block-renderer": {
      "types": "./dist/api/editable-block-renderer.d.ts",
      "import": "./dist/api/editable-block-renderer.js"
    },
    "./keybindings": {
      "types": "./dist/api/keybindings.d.ts",
      "import": "./dist/api/keybindings.js"
    },
    "./block-operations": {
      "types": "./dist/api/block-operations.d.ts",
      "import": "./dist/api/block-operations.js"
    },
    "./typing-triggers": {
      "types": "./dist/api/typing-triggers.d.ts",
      "import": "./dist/api/typing-triggers.js"
    },
    "./styles.css": {
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/styles/editor.css', 'dist/index.css')\"",
    "dev:compiler": "tsc -p tsconfig.build.json --watch",
    "check-types:source": "tsc --noEmit -p tsconfig.json",
    "check-types:tests": "tsc --noEmit -p tsconfig.test.json",
    "check-types": "pnpm run check-types:source && pnpm run check-types:tests && pnpm run typecheck:contracts",
    "typecheck": "pnpm run check-types",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/editor-dom": "workspace:*",
    "@repo/editor-core": "workspace:*",
    "@repo/editor-react": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.0.15",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.1",
    "jsdom": "^27.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.2",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
