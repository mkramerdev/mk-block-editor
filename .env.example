# Local Compose database defaults. Use a secret password in production.
EDITOR_DB_NAME=editor_document
EDITOR_DB_USER=editor
EDITOR_DB_PASSWORD=editor
EDITOR_DB_PORT=5435

# First Draft document and realtime service configuration.
FIRST_DRAFT_DOCUMENT_ID=01890f07-1c00-7000-8000-000000040001
FIRST_DRAFT_SEED_DOCUMENT_ID=01890f07-1c00-7000-8000-000000040001
EDITOR_REALTIME_PUBLIC_DOCUMENT_IDS=01890f07-1c00-7000-8000-000000040001
EDITOR_REALTIME_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# In-process, per-realtime-instance public demo limits.
EDITOR_REALTIME_MAX_CONNECTIONS=100
EDITOR_REALTIME_MAX_CONNECTIONS_PER_ADDRESS=10
EDITOR_REALTIME_MAX_SESSIONS_PER_DOCUMENT=50
EDITOR_REALTIME_MAX_MESSAGES_PER_WINDOW=2400
EDITOR_REALTIME_MESSAGE_WINDOW_MS=60000
EDITOR_REALTIME_MAX_TRANSACTIONS_PER_WINDOW=600
EDITOR_REALTIME_TRANSACTION_WINDOW_MS=60000
EDITOR_REALTIME_MAX_BYTES_PER_WINDOW=67108864
EDITOR_REALTIME_BYTE_WINDOW_MS=60000
EDITOR_REALTIME_MAX_CLIENT_FRAME_BYTES=2097152
EDITOR_REALTIME_MAX_PENDING_TRANSACTIONS_PER_DOCUMENT=64

# Optional Vite overrides. The React playground already uses these local values
# when the variables are unset.
VITE_FIRST_DRAFT_DOCUMENT_ID=01890f07-1c00-7000-8000-000000040001
VITE_EDITOR_REALTIME_URL=ws://localhost:4455/editor-realtime
