{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "EDITOR_DOCUMENT_POSTGRES_URL",
    "FIRST_DRAFT_SEED_DOCUMENT_ID",
    "VITE_EDITOR_REALTIME_URL",
    "VITE_FIRST_DRAFT_DOCUMENT_ID"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:reset": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev:prepare": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev:consumer": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
