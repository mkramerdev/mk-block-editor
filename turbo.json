{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "EDITOR_DOCUMENT_POSTGRES_URL",
    "FIRST_DRAFT_SEED_DOCUMENT_ID",
    "VITE_EDITOR_REALTIME_URL",
    "VITE_FIRST_DRAFT_DOCUMENT_ID"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
