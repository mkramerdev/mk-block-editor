{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev:consumer": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "EDITOR_DOCUMENT_POSTGRES_URL",
        "EDITOR_REALTIME_*",
        "NODE_ENV"
      ]
    }
  }
}
